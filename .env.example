# ==========================================
# 🌐 HanUp (한업 | 韩升) 환경 변수 템플릿
# ==========================================
# 이 파일을 복사하여 .env.local 파일로 생성한 뒤 실제 키 값을 입력하세요.
# .env.local 파일은 .gitignore에 등록되어 GitHub에 노출되지 않습니다.

# ------------------------------------------
# 1. AI API 키 (첨삭 및 Vision OCR)
# ------------------------------------------
# TOPIK 53/54번 AI 정밀 첨삭 (/api/ai/grade)
# OpenAI 또는 DeepSeek API Key (예: sk-proj-...)
OPENAI_API_KEY=

# 손글씨 원고지 사진 Vision OCR 디지털화 (/api/ai/ocr)
# Google AI Studio Gemini API Key (예: AIzaSy...)
GEMINI_API_KEY=

# ------------------------------------------
# 2. HanUp Suite 3대 앱 연동 URL
# ------------------------------------------
# 한업 (HanUp) 배포 주소 (로컬: http://localhost:3000, 배포 후: https://hanup-platform.vercel.app)
NEXT_PUBLIC_HANUP_URL=http://localhost:3000

# 소리튜터 (Sori Tutor) AI 발음·연음 클리닉 앱 주소
NEXT_PUBLIC_SORI_TUTOR_URL=https://sori-tutor.vercel.app

# 우리반 (UriBan) 학급 관리 LMS & 교사 정밀 첨삭 주소
NEXT_PUBLIC_URIBAN_URL=http://localhost:3001

# ------------------------------------------
# 3. 결제 및 스토어 링크 (선택 사항)
# ------------------------------------------
# 네이버 스마트스토어 상품 결제 URL
NEXT_PUBLIC_NAVER_STORE_URL=https://smartstore.naver.com

# Lemon Squeezy 글로벌 달러 결제 체크아웃 URL
NEXT_PUBLIC_LEMON_SQUEEZY_URL=https://hanup.lemonsqueezy.com
