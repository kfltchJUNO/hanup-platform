# ==========================================================================
# 🌐 HanUp (한업 | 韩升) 환경 변수 템플릿
# ==========================================================================

# [1] 쓰기 피드백 전용 키 (TOPIK 53/54번 AI 정밀 첨삭용 키 2개 분산)
GEMINI_KEY_WRITING_1=
GEMINI_KEY_WRITING_2=

# [2] 이미지 분석 전용 키 (손글씨 원고지 Vision OCR 판독용 키 2개 분산)
GEMINI_KEY_OCR_1=
GEMINI_KEY_OCR_2=

# [3] 공통 백업 키 (선택 사항)
GEMINI_API_KEY=

# [4] HanUp Suite 3대 앱 연동 URL
NEXT_PUBLIC_HANUP_URL=http://localhost:3000
NEXT_PUBLIC_SORI_TUTOR_URL=https://sori-tutor.vercel.app
NEXT_PUBLIC_URIBAN_URL=http://localhost:3001

# [5] 결제 및 스토어 링크 (선택 사항)
NEXT_PUBLIC_NAVER_STORE_URL=https://smartstore.naver.com
NEXT_PUBLIC_LEMON_SQUEEZY_URL=https://hanup.lemonsqueezy.com

# [6] Firebase 설정 (Google 로그인 및 소리튜터·우리반 통합 계정 연동)
# ※ Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹) SDK 설정에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# [7] ElevenLabs TTS (선생님 커스텀 AI 목소리 연동)
# ※ 크레딧 보호를 위해 브라우저에 노출되지 않도록 서버 전용(NEXT_PUBLIC_ 제외)으로 관리
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2


